# Paddock OS: mount every data drive that isn't part of the system under /srv/media/<label>,
# where Paddock's folder picker finds it. paddock-mount skips the system disk and the installer USB.
SUBSYSTEM=="block", ACTION=="add", ENV{ID_FS_USAGE}=="filesystem", ENV{ID_FS_TYPE}=="ext4|ext3|ext2|xfs|btrfs|ntfs|ntfs3|exfat|vfat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="paddock-mount@%k.service"
