# Paddock OS service settings (read by paddock.service).
# Manage server → System changes the hostname line; everything else is fixed by the OS layout.
PADDOCK_DATA_DIR=/srv/data/paddock
PADDOCK_MEDIA_ROOTS=/srv/media
PADDOCK_HOST=0.0.0.0
PADDOCK_PORT=443
PADDOCK_TLS=1
PADDOCK_HOSTNAMES=paddock.local
PADDOCK_HWACCEL=auto
PADDOCK_FFMPEG=/opt/paddock-ffmpeg/bin/ffmpeg
PADDOCK_FFPROBE=/opt/paddock-ffmpeg/bin/ffprobe
PADDOCK_WG_ENABLED=1
PADDOCK_AGENT_SOCKET=/run/paddock-agent.sock
