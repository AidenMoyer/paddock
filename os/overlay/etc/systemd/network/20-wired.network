# Paddock OS: every wired port gets an address by DHCP and answers to <hostname>.local.
# Manage server → System → Network rewrites this file for a fixed address.
[Match]
Name=en* eth*

[Network]
DHCP=yes
MulticastDNS=yes
LLMNR=no
IPv6AcceptRA=yes

[DHCPv4]
UseDomains=yes
# Identify by the network card, not by this install, so upgrading or reinstalling keeps the same address
# and an address reserved on the router for this machine just works.
ClientIdentifier=mac
