<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext, no user-installed CAs. Paddock connections use their own pinned trust (see PinnedTls.kt). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
