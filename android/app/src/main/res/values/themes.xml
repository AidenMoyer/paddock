<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window before Compose starts (matches Tokens.Dark.bg). -->
    <style name="Theme.Paddock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paddock_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paddock_bg">#FF0F0F0F</color>
    <color name="paddock_accent">#FFFF3B30</color>
</resources>
